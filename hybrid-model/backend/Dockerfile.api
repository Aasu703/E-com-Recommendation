FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml poetry.lock* README.md ./
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/* && pip install poetry && poetry config virtualenvs.create false && poetry install --no-root --without dev
COPY . .
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
